# Скопируйте этот файл в .env рядом с ним и впишите свои данные.
# .env не попадает в git (см. .gitignore) — сюда можно писать настоящие имена.
# Пустое значение = заглушка по умолчанию.

# Шапка титульного листа. <br/> — перенос строки; строку с «кавычками» сервис делает жирной.
REFERENCE_UNIVERSITY_HEADER=МИНИСТЕРСТВО НАУКИ И ВЫСШЕГО ОБРАЗОВАНИЯ РОССИЙСКОЙ ФЕДЕРАЦИИ<br/>федеральное государственное автономное образовательное учреждение высшего образования<br/>«НАЗВАНИЕ УНИВЕРСИТЕТА»
REFERENCE_DEPARTMENT=КАФЕДРА № 00
REFERENCE_TEACHER_POSITION=доцент, к.т.н.
REFERENCE_TEACHER_NAME=Фамилия И.О.
REFERENCE_DISCIPLINE=Введение в информационные технологии
REFERENCE_CITY=Москва

# ФИО и группу удобнее ввести в веб-интерфейсе («Мои данные») — там они важнее этих строк.
STUDENT_NAME=
STUDENT_GROUP=

# Необязательно: ключ Google Drive API (для папок с нативными Google Docs).
# Обычные публичные папки читаются и без него.
GOOGLE_DRIVE_API_KEY=
